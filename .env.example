APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for older Supabase projects. Prefer the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for trusted payment-intent and verified-webhook database writes.
# Never prefix this key with NEXT_PUBLIC_ or use it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# ABA PayWay checkout. Set PAYMENT_PROVIDER=aba_payway only after you have sandbox or production credentials.
PAYMENT_PROVIDER=NOT_CONFIGURED
PAYWAY_ENV=sandbox
PAYWAY_MERCHANT_ID=
# Server-only PayWay API key. Never expose it to browser code.
PAYWAY_API_KEY=
# Optional PayWay payment_option. Leave blank to let the hosted checkout show merchant-enabled methods.
PAYWAY_PAYMENT_OPTION=

PLAYER_VERIFICATION_PROVIDER=NOT_CONFIGURED
TOPUP_PROVIDER=NOT_CONFIGURED
